# Copia este archivo a .env y ajusta los valores.
# (Si no existe .env, la app arranca con estos valores de desarrollo.)

PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=data/globaltrade.db

# Cambia este secreto en cualquier entorno que no sea tu máquina local
SESSION_SECRET=dev-only-cambia-este-secreto-en-produccion

# Cuentas de prueba que crea el seed (solo desarrollo)
ADMIN_NAME=Administrador Demo
ADMIN_EMAIL=admin@globaltrade.test
ADMIN_PASSWORD=Admin-Demo-2026!
COMPANY_DEMO_EMAIL=empresa@globaltrade.test
COMPANY_DEMO_PASSWORD=Empresa-Demo-2026!

# Destinatario de los avisos internos (nuevas empresas, solicitudes de proveedores…)
ADMIN_NOTIFY_EMAIL=admin@globaltrade.test
