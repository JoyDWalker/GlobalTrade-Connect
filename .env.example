# GlobalTrade Connect · variables de entorno
# Copia este archivo a .env.local (desarrollo). En Vercel/Railway define las variables en el panel de cada entorno.
# NUNCA subas archivos .env con valores reales. Usa valores distintos en development, preview y production.

# ── Entorno ──────────────────────────────────────────────────────────────
# development | preview | production (en Vercel se deduce de VERCEL_ENV si no se define)
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos PostgreSQL ─────────────────────────────────────────────
# Supabase: usa la cadena del "Transaction pooler" (puerto 6543) para Vercel.
# Local sin Docker: npm run db:local  →  postgres://postgres@127.0.0.1:54329/postgres
DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# disable (solo local) | require (cifrado) | verify-full (cifrado + verificación del certificado con DATABASE_CA_CERT)
DATABASE_SSL=disable
# Certificado raíz del proveedor en PEM (opcional, recomendado en producción con verify-full)
DATABASE_CA_CERT=
# Conexiones por instancia (1 con la base local PGlite; 3-5 en serverless)
DB_POOL_MAX=1

# ── Supabase Auth y Storage ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Es pública por diseño; los datos están protegidos por RLS y por el servidor.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave privilegiada (service_role / secret). SOLO servidor: subida de logos y borrado de cuentas (RGPD).
SUPABASE_SERVICE_ROLE_KEY=

# ── Fuentes externas de búsqueda (opcionales) ────────────────────────────
# Serper.dev (resultados de Google, de pago por uso): https://serper.dev/ — buscador principal recomendado
SERPER_API_KEY=
# Brave Search API (de pago por uso): https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Google Custom Search JSON API: cerrada a clientes nuevos y con retirada anunciada el 1/1/2027
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ENGINE_ID=

# ── IA para ampliar las búsquedas (opcional) ─────────────────────────────
# Con clave, cada producto nuevo («dulces», «licor»…) se amplía con su sector, términos relacionados y
# consultas optimizadas (se guarda en caché y su coste cuenta en el presupuesto diario).
# Sin clave, se amplía con el catálogo de sectores. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo de Claude (opcional). Por defecto claude-opus-5-5
AI_MODEL=

# ── Correo transaccional ─────────────────────────────────────────────────
# log = no envía (se ve en Admin → Emails) | resend = envía con Resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=GlobalTrade Connect <no-reply@tu-dominio.com>
ADMIN_NOTIFY_EMAIL=

# ── Seguridad ────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Protege /api/cron/worker (Vercel Cron lo envía como "Authorization: Bearer ...")
CRON_SECRET=

# ── Monitorización ───────────────────────────────────────────────────────
# Webhook de Slack/Discord/Teams para alertas (fallos del worker, presupuesto de APIs agotado…)
ALERT_WEBHOOK_URL=
# debug | info | warn | error | silent
LOG_LEVEL=info

# ── Solo desarrollo local sin Supabase ───────────────────────────────────
# Actúa como este usuario (debe existir en la tabla profiles). Se ignora si APP_ENV≠development o si Supabase está configurado.
DEV_FAKE_AUTH_EMAIL=
