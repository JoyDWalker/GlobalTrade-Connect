{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/worker", "schedule": "0 4 * * *" }
  ],
  "functions": {
    "src/app/api/cron/worker/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/jobs/route.ts": { "maxDuration": 60 },
    "src/app/api/admin/export/[entity]/route.ts": { "maxDuration": 60 },
    "src/app/api/search/external/route.ts": { "maxDuration": 30 }
  }
}
